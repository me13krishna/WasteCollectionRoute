# EcoRoute AI - Environment Configuration Template
# Copy this file to .env and adjust variables as required

PROJECT_NAME="EcoRoute AI - Municipal Waste Collection Route Optimization"
API_V1_STR="/api/v1"
JWT_SECRET="super-secret-waste-route-key-2026-production"

# Database Configuration
# Default: Zero-friction local SQLite database
DATABASE_URL="sqlite:///./waste_route.db"
# Optional PostgreSQL/PostGIS:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecoroute"

# Road Routing Engine (OSRM)
# Default: Public OpenStreetMap routing server
OSRM_BASE_URL="https://router.project-osrm.org"
# Local self-hosted OSRM instance:
# OSRM_BASE_URL="http://localhost:5000"
OSRM_TIMEOUT_SEC=2.5
OSRM_MAX_RETRIES=2
OSRM_BATCH_SIZE=50

# Regional Currency & SI Logistics Units (Default: Pune, Maharashtra, India)
CURRENCY_SYMBOL="₹"
CURRENCY_CODE="INR"
DISTANCE_UNIT="km"
VOLUME_UNIT="L"
MASS_UNIT="kg"

# Municipal Fleet Cost & Environmental Constants (EEA MEET Model)
FUEL_L_PER_KM=0.42
CO2_KG_PER_L=2.68
FUEL_COST_PER_L=94.50
DRIVER_HOURLY_RATE=250.00
TRUCK_IDLE_FUEL_L_PER_HR=2.40
COMPACTOR_PTO_L_PER_STOP=0.035

# Road Network Circuity Fallback Parameters
CIRCUITY_FACTOR=1.32
TRUCK_AVG_SPEED_KMH=27.0

# Solver Settings
DEFAULT_OPT_TIME_LIMIT_SEC=15
